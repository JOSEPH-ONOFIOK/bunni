# X (Twitter) OAuth 2.0 — from developer.x.com, with the callback registered as
# <your site>/api/x/callback. Leave both unset to run without the connect step:
# the form then takes the handle you type at face value.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Signs the session cookie holding the connected X identity. 32+ random chars.
# Required in production; dev falls back to a per-process key.
SESSION_SECRET=

# Canonical origin, used for OG images and the OAuth redirect in production.
# On Vercel this is inferred; set it for any other host.
NEXT_PUBLIC_SITE_URL=

# Optional. When set, submissions go to a Google Apps Script web app instead of
# the local data/allowlist.json file — which is what production needs, since a
# serverless filesystem is read-only.
GOOGLE_SHEETS_WEBAPP_URL=
