# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents what has to be set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allowlist submissions (local dev fallback). Excluded file by file rather
# than as a whole directory, because git will not re-include anything inside a
# directory it has already excluded — and the holder snapshots below have to
# ship with the deploy.
/data/*.json
/data/.snapshot-state

# The snapshots themselves are data the server must be able to read in
# production, where the filesystem is read-only and nothing can be uploaded
# after the fact, so they are committed.

# source images, kept locally; the site uses the named copies in public/pfp
/public/WhatsApp Image*

# unused create-next-app scaffold art
/public/next.svg
/public/vercel.svg
/public/globe.svg
/public/window.svg
/public/file.svg

# the banner is committed as brand-banner.png
/public/IMG_*.PNG
